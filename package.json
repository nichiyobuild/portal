{
	"name": "portal",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "$npm_execpath run build && vite preview",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"lint": "biome check .",
		"format": "biome check --write --unsafe .",
		"typecheck": "tsc --noEmit"
	},
	"imports": {
		"#/": "./src/"
	},
	"engines": {
		"node": ">=26.0.0",
		"npm": ">=11.0.0"
	},
	"dependencies": {
		"hono": "^4.12.32"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@cloudflare/vite-plugin": "^1.48.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vite-ssr-components": "^0.6.1",
		"wrangler": "^4.115.0"
	}
}
